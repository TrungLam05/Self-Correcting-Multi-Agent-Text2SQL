# Default: normalize all text files
* text=auto

# Shell scripts - always LF
*.sh     text eol=lf

# Python / SQL / YAML / Markdown
*.py     text eol=lf
*.sql    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf

# Windows command scripts
*.cmd    text eol=crlf
*.bat    text eol=crlf